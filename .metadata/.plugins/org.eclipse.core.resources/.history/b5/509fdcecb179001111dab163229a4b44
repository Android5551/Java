package strngs;

public class Anagram {

	public static void main(String[] args) {
		// Check whether two strings are anagrams.
		// Example: "silent" and "listen" are anagrams because
		// sorting both gives "eilnst".
		String s = "silent";
		String t = "listen";
		char[] arr = s.toCharArray(); // as string is immutable placing it in char array

		char temp = 0;
		// s i
		// i j
		for (int i = 0; i < arr.length; i++) {
			for (int j = i + 1; j < arr.length; j++) {
				if (arr[i] > arr[j]) {
					temp = arr[j]; // s i ;temp = i
					arr[j] = arr[i]; // i = s ;i i
					arr[i] = temp; // i s
				}
			}
		}
		System.out.println(arr);
	}
}
