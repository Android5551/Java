package arrays;

public class ArraySorting {

	public static void main(String[] args) {

		int[] arr = { 20, 10, 50, 30, 40 };
		int temp = 0;

		for (int i = 0; i < arr.length; i++) {
			for (int j = i + 1; j < arr.length; j++) {
				if (arr[j] < arr[i]) {
					temp = arr[j];
					arr[j] = arr[i];
					arr[i] = temp;
				}
			}

			System.out.println(arr[i]);
		}

	}

}
