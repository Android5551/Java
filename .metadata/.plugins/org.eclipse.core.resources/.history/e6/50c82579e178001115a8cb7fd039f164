package strngs;

public class CountStrngs {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
			String x = "Hello";
			int count = 0;
			for (int i = 0; i< x.length(); i++) {
				count = count + 1;
			}
			System.out.println("Total number of characters in "+x+" are : "+count);
	}

}
