package strngs;

public class CountAllOccurrence {

	public static void main(String[] args) {
		// TODO Auto-generated method stub
		String s = "happy";
		char p = 'p';
		int count = 0;

		for (int i = 0; i < s.length(); i++) {
			if (s.charAt(i) == p) {
				count++;
			}
		}
		System.out.println(count);

	}

}
