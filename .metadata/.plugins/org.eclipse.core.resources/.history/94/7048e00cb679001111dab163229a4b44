package strngs;

public class Anagram {

	public static void main(String[] args) {
		// Check whether two strings are anagrams.
		// Example: "silent" and "listen" are anagrams because
		// sorting both gives "eilnst".
		String s = "silent";
		String t = "listen";
		char[] arrS = s.toCharArray(); // as string is immutable placing it in char array
		char[] arrT = t.toCharArray();

		char temp = 0;
		// s i
		// i j
		
		for (int i = 0; i < arrS.length; i++) {
			for (int j = i + 1; j < arrS.length; j++) {
				if (arrS[i] > arrS[j]) {
					temp = arrS[j]; // s i ;temp = i
					arrS[j] = arrS[i]; // i = s ;i i
					arrS[i] = temp; // i s
				}
			}
		}
		for (int i = 0; i < arrT.length; i++) {
			for (int j = i + 1; j < arrT.length; j++) {
				if (arrT[i] > arrT[j]) {
					temp = arrT[j];
					arrT[j] = arrT[i];
					arrT[i] = temp;
				}
			}
		}
		System.out.println(arrS);
		System.out.println(arrT);
		boolean anagram = false;

		for (int i = 0; i < arrS.length; i++) {

			if (arrS[i] == arrT[i] && arrS.length == arrT.length) {
				// System.out.println(arrS[i]+" "+arrT[i]);
				anagram = true;
				// System.out.println("Not Anagram"+);
			}

		}

		if (anagram = true) {
			System.out.println("Anagram");
		} else {
			System.out.println("Not Anagram");
		}
		
	}
}

