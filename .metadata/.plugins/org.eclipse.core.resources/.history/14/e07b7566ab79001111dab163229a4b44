package strngs;

public class SubString {

	public static void main(String[] args) {
		// TODO if string is abcdef so it will print 6 otherwise if string is ujlujl it
		// will print 3
		String s = "uljulj";
		int count = 0;
		int c = 0;
		for (char i = 'a'; i <= 'z'; i++) {
			for (int j = 0; j <= s.length() - 1; j++) {
				if (i == s.charAt(j)) {
//					System.out.println(i + " " + s.charAt(j));
					count++;
					
				}
			}
			if (count > 0) {
				System.out.println(i + " = " + count);
				count = 0; // to reset counter for other chars
				c++;
			}
		}
		System.out.println(c);
	}
}


