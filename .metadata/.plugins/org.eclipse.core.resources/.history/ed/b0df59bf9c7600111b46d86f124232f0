package arrays;

public class PrintMaxAndMin {
public static void main(String[] args) {
	int [] intarr = {1,3,4,5};
	// TODO max and min. element
	for(int i = 0; i < 3; i++) {
		int max = intarr[i];
		for(int j =0;j<4;j++) {
			
			System.out.println(intarr[j]);
			if(max > intarr[j]) {
				System.out.println("yes "+max);
			}
			else {
				System.out.println("no "+max);
			}
			}
	}
	
	}

	
}

