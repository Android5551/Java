package strngs;

public class StringMeths {

	public static void main(String[] args) {
		// TODO String Methods
		
		String s = "Vijay Singh"; // it is immutable so can't be changed
		
		// .length()
		System.out.println(s.length());
		// last index
		System.out.println(s.length()-1);
		// character at index 0
		System.out.println(s.charAt(0));
		// Index of 'Singh' in s 
		System.out.println(s.indexOf("Singh")); 
		// first i position
		System.out.println(s.indexOf("i")); // 1
		// last i position 
		System.out.println(s.lastIndexOf("i")); //7
		// replace i's with a's
		System.out.println(s.replace('i', 'a'));
		// lowercase
		System.out.println(s.toLowerCase());
		// uppercase
		System.out.println(s.toUpperCase());
		// checks if string starts with given char (case-sensitive)
		System.out.println(s.startsWith("V"));
		// checks if string starts with given char (case-sensitive)
		System.out.println(s.endsWith("ngh"));
		

	}

}
