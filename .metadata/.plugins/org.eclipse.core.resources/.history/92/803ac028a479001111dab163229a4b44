package strngs;

public class SubString {

	public static void main(String[] args) {
		// TODO if string is abcdef so it will print 6 otherwise if string is ujlujl it will print 3
		String s = "abcabc"; 
		int count = 0;
		for(char i = 'a'; i<= 'z'; i++ ) {
			for(int j = 0; j<=s.length()-1; j++) {
				if(i == s.charAt(j)) {
					System.out.println(i+" "+s.charAt(j));
					count++;
			
				}
			}
			
		}
		System.out.println(count);
		
		
	}
}


