package arrays;

// TODO sort array in descending order 
public class DescArray {
	public static void main(String[] args) {
		int [] arr = {0,43,1,2,32,21,4};
		int temp = 0;
		//comparing index 0 with 1 to 6 likewise 1 with 2 to 6
		for(int x = 0; x < arr.length; x++) {
			for(int y=x+1; y < arr.length; y++)
			{
				// no. which is larger shifted to first index
				System.out.println(x+" "+y);
				if (arr[x] < arr[y]) {
					temp = arr[x];
					arr[x] = arr[y];
					arr[y] = temp;
					
				}
				System.out.println("inner loop "+arr[x]+" "+arr[y]);
			}
//			System.out.println(arr[x]);
			// printing sorted array
			for (int a: arr) {
				System.out.print(a + ", ");
				System.out.println();
				
			}
		}
	}
}
