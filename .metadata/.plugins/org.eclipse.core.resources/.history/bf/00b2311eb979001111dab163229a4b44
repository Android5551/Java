package strngs;

public class Anagram {

	public static void main(String[] args) {
		// TODO Check whether two strings are anagrams.
		// "silent" and "listen" are anagrams because
		// Bubble sorting both gives "eilnst".
		String s = "abc";
		String t = "cba";
		
		// as string is immutable placing it in char array
		char[] arrS = s.toCharArray(); 
		char[] arrT = t.toCharArray();

		char temp = 0;
		// s i
		// i j
		
		// bubble sort array S
		for (int i = 0; i < arrS.length; i++) {
			for (int j = i + 1; j < arrS.length; j++) {
				if (arrS[i] > arrS[j]) {
					temp = arrS[j]; // s i ;temp = i
					arrS[j] = arrS[i]; // i = s ;i i
					arrS[i] = temp; // i s
				}
			}
		}
		// bubble sort array T
		for (int i = 0; i < arrT.length; i++) {
			for (int j = i + 1; j < arrT.length; j++) {
				if (arrT[i] > arrT[j]) {
					temp = arrT[j];
					arrT[j] = arrT[i];
					arrT[i] = temp;
				}
			}
		}
		
		System.out.println(arrS);
		System.out.println(arrT);
		
		if (arrS == arrT) {
			System.out.println("anagram");
			
		}
		else {
			System.out.println("not anagram");
		}
		
		// flag to check if anagram or not
	}
}
