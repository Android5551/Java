package programs;

public class Armstrong {

	public static void main(String[] args) {
		// TODO whether the given no. is Armstrong
		/*
		 * 153 is an Armstrong number because it has 3 digits:
		 * 1^3 +5^3 +3^3 = 1 + 125 + 27 = 153
         */
		int num = 153;
		while(num >= 0) {
			System.out.println(num);
			num = num / 10;
			System.out.println(num);
		}
	
	}

}
