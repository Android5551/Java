package com.rays.oop.overriding;

public class TestShape1 {
	public static void main(String[] args) {
		Shape s1 = new Circle();
		// parent shape can't call method of child
		
		// type casting parent to child
		// type cast s1(parent obj) into c(child obj) or down-casting
		Circle c = (Circle) s1;
		
		c.setColor("Blue");
		c.setBorderwidth(3);
		c.setRadius(4);
		
		c.area();
		
		System.out.println("-----Rectangle-----");
		
		Shape s2 = new Rectangle();
		// type cast
		Rectangle r = (Rectangle) s2;
		
		r.setColor("red");
		r.setBorderwidth(2);
		r.setLength(1);
		r.setWidth(3);

		r.area();
		
		System.out.println("-----------Triangle----------");
		
		Shape s3 = new Triangle();
	}
	
	
	
}