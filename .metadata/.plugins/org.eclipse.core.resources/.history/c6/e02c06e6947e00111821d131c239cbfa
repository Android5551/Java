package com.rays.oop.overriding;

public class TestShape {

	public static void main(String[] args) {

		Circle c = new Circle();
		// gets all radius and border width and color
		
		c.setBorderwidth(2);
		c.setColor("green");
		c.setRadius(4);
		
		c.getBorderwidth();
		c.getRadius();
		c.getColor();
		c.area();
		
		System.out.println("-------------------");
		
		Rectangle r = new Rectangle();
		
		r.setBorderwidth(3);
		r.setColor("brown");
		r.setLength(3);
		r.setWidth(2);
		
		r.getBorderwidth();
		r.getColor();
		r.getLength();
		r.getWidth();
		r.area();
	}

}
