package arrays;

public class Arrays {
public static void main(String[] args) {
	int [] intarr = {1,3,4,5};
	System.out.println(intarr.length); //4 is length of array
	System.out.println(intarr[3]); // for index ; starts from 0
	// sum of array values
	System.out.println(intarr[0]+intarr[intarr.length]);
	// appending strings
	System.out.println(intarr[0]+" "+intarr[intarr[2]]);
	
}
}
