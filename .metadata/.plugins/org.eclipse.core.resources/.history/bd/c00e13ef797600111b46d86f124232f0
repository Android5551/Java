package programs;

public class calculate {

	public static void main(String[] args) {
		// initialize
		int a = 21;
		int b = 93;
		
		// addition
		int sum = a + b;
		
		// subtraction
		int sub = a - b;
		
		// multiplication
		int mul = a * b;
		
		// division
		int div = a / b;
		
		System.out.println("Sum : "+sum +" Subtract: "+sub+ " Multiply: "+mul+ " Division: "+div);
		
		

	}

}
